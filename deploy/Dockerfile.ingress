ARG GO_IMAGE=golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.* ./
COPY cmd/covee-ingress ./cmd/covee-ingress
COPY internal/ingress ./internal/ingress
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /covee-ingress ./cmd/covee-ingress

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /covee-ingress /covee-ingress
USER 10001:10001
EXPOSE 8443 8444
ENTRYPOINT ["/covee-ingress"]
