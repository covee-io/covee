ARG GO_IMAGE=golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.* ./
RUN go mod download
COPY cmd/covee-identity ./cmd/covee-identity
COPY internal/identity ./internal/identity
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /covee-identity ./cmd/covee-identity

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /covee-identity /covee-identity
USER 10001:10001
EXPOSE 8446
ENTRYPOINT ["/covee-identity"]
