ARG GO_IMAGE=golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY deploy/console-node/go.mod deploy/console-node/go.sum ./
RUN go mod download
COPY deploy/console-node/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /covee-console-node .

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /covee-console-node /covee-console-node
USER 10001:10001
ENTRYPOINT ["/covee-console-node"]
