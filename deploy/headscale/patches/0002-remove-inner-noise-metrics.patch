+package hscontrol
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/net/http2"
+	"tailscale.com/control/controlhttp"
+	"tailscale.com/tailcfg"
+	"tailscale.com/types/key"
+)
+
+// Exercise the real public HTTP upgrade, Noise handshake and inner HTTP/2
+// router with a fresh machine key that has never enrolled. An ingress filter
+// can only see /ts2021, so the backend must not mount diagnostics in this tunnel.
+func TestCoveeUnregisteredNoiseCannotReadMetrics(t *testing.T) {
+	app := createTestApp(t)
+	server := httptest.NewServer(app.HTTPHandler())
+	defer server.Close()
+	endpoint, err := url.Parse(server.URL)
+	require.NoError(t, err)
+	machine := key.NewMachine()
+	require.Empty(t, app.state.GetNodesByMachineKeyAllUsers(machine.Public()))
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	dialer := &controlhttp.Dialer{
+		Hostname: endpoint.Hostname(), HTTPPort: endpoint.Port(),
+		HTTPSPort:  controlhttp.NoPort,
+		MachineKey: machine, ControlKey: app.noisePrivateKey.Public(),
+		ProtocolVersion: uint16(tailcfg.CurrentCapabilityVersion),
+	}
+	conn, err := dialer.Dial(ctx)
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(10*time.Second)))
+
+	// Consume the authenticated early payload before handing the stream to HTTP/2.
+	var header [9]byte
+	_, err = io.ReadFull(conn, header[:])
+	require.NoError(t, err)
+	require.Equal(t, earlyPayloadMagic, string(header[:5]))
+	length := binary.BigEndian.Uint32(header[5:])
+	require.Less(t, length, uint32(4096))
+	_, err = io.CopyN(io.Discard, conn, int64(length))
+	require.NoError(t, err)
+
+	transport := &http2.Transport{}
+	client, err := transport.NewClientConn(conn)
+	require.NoError(t, err)
+	defer client.Close()
+	for _, path := range []string{"/metrics", "/metrics/"} {
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://"+endpoint.Host+path, nil)
+		require.NoError(t, err)
+		response, err := client.RoundTrip(request)
+		require.NoError(t, err)
+		body, err := io.ReadAll(io.LimitReader(response.Body, 4096))
+		response.Body.Close()
+		require.NoError(t, err)
+		require.Equal(t, http.StatusNotFound, response.StatusCode, "%s: %s", path, body)
+		require.NotContains(t, string(body), "go_gc_duration_seconds")
+	}
+	require.Empty(t, app.state.GetNodesByMachineKeyAllUsers(machine.Public()), "request must not enroll a device")
+}
