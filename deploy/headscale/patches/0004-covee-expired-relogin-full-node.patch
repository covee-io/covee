+package servertest_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/juanfont/headscale/hscontrol/servertest"
+	"github.com/juanfont/headscale/hscontrol/types"
+	"github.com/stretchr/testify/require"
+	"tailscale.com/tailcfg"
+)
+
+// TestCoveeExpiredReloginClearsExpiredForPeers reproduces a device whose key
+// expired signing in again while its peers stay connected. Expiry reaches the
+// peers as the whole node with Expired set, which the Tailscale client keeps;
+// a peer patch cannot clear Expired or MachineAuthorized, so after a
+// patch-only relogin the peers kept dropping the device's traffic until they
+// reconnected. The relogin must reach the peers as the whole node.
+func TestCoveeExpiredReloginClearsExpiredForPeers(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range []struct {
+		name string
+		// expire makes a's key expire while b stays connected, then signs a in again.
+		expire  func(t *testing.T, h *servertest.TestHarness, a *servertest.TestClient)
+		relogin func(t *testing.T, a *servertest.TestClient)
+	}{
+		{
+			name: "key_expired_on_server",
+			expire: func(t *testing.T, h *servertest.TestHarness, a *servertest.TestClient) {
+				t.Helper()
+
+				past := time.Now().Add(-time.Minute)
+				_, c, err := h.Server.State().SetNodeExpiry(nodeIDByName(t, h, a.Name), &past)
+				require.NoError(t, err)
+				h.Server.App.Change(c)
+			},
+			relogin: func(t *testing.T, a *servertest.TestClient) {
+				t.Helper()
+				a.Disconnect(t)
+				a.Reconnect(t)
+			},
+		},
+		{
+			name: "logout_then_login",
+			expire: func(t *testing.T, _ *servertest.TestHarness, a *servertest.TestClient) {
+				t.Helper()
+
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+
+				require.NoError(t, a.LogoutAndDisconnect(ctx))
+			},
+			relogin: func(t *testing.T, a *servertest.TestClient) {
+				t.Helper()
+
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+
+				require.NoError(t, a.ReloginAndPoll(ctx))
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			h := servertest.NewHarness(t, 2)
+			a, b := h.Client(0), h.Client(1)
+
+			tc.expire(t, h, a)
+			waitForPeer(t, b, a.Name, "marked expired", func(p tailcfg.NodeView) bool {
+				return p.Expired()
+			})
+
+			tc.relogin(t, a)
+			waitForPeer(t, b, a.Name, "usable again after signing in", func(p tailcfg.NodeView) bool {
+				return !p.Expired() && p.MachineAuthorized() &&
+					(p.KeyExpiry().IsZero() || p.KeyExpiry().After(time.Now()))
+			})
+		})
+	}
+}
+
+// waitForPeer waits until c sees the peer named name in the wanted state, and
+// otherwise fails with the state it last saw.
+func waitForPeer(t *testing.T, c *servertest.TestClient, name, want string, cond func(tailcfg.NodeView) bool) {
+	t.Helper()
+
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if p, ok := c.PeerByName(name); ok && cond(p) {
+			return
+		}
+
+		time.Sleep(20 * time.Millisecond) //nolint:forbidigo // polling a client's netmap
+	}
+
+	p, ok := c.PeerByName(name)
+	if !ok {
+		t.Fatalf("%s never saw %s %s: the peer is missing", c.Name, name, want)
+	}
+
+	t.Fatalf("%s never saw %s %s: Expired=%v MachineAuthorized=%v KeyExpiry=%v Key=%v",
+		c.Name, name, want, p.Expired(), p.MachineAuthorized(), p.KeyExpiry(), p.Key().ShortString())
+}
+
+func nodeIDByName(t *testing.T, h *servertest.TestHarness, name string) types.NodeID {
+	t.Helper()
+
+	for _, n := range h.Server.State().ListNodes().All() {
+		if n.Hostname() == name {
+			return n.ID()
+		}
+	}
+
+	t.Fatalf("no node named %q", name)
+
+	return 0
+}
