+		"acls": [],
+		"ssh": [{
+			"action": "accept",
+			"src":    ["autogroup:member"],
+			"dst":    ["autogroup:self"],
+			"users":  ["root"]
+		}]
+	}`
+
+	for name, without := range map[string]string{
