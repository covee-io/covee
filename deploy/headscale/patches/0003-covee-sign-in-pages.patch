diff --git a/hscontrol/assets/style.css b/hscontrol/assets/style.css
index 357fcb1..a9c4e56 100644
--- a/hscontrol/assets/style.css
+++ b/hscontrol/assets/style.css
@@ -235,3 +235,48 @@ input:focus-visible {
     scroll-behavior: auto !important;
   }
 }
+
+/* Covee: the look of the network's own sign-in pages. */
+:root {
+  --md-text-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --md-code-font: ui-monospace, SFMono-Regular, Menlo, monospace;
+  --md-default-fg-color: #1F2A44;
+  --md-default-fg-color--light: #5B6478;
+  --md-primary-fg-color: #2563EB;
+  --md-accent-fg-color: #1D4FD8;
+  --hs-border: #D9DFE9;
+  --hs-bg: #F2F5FA;
+  --hs-focus-ring: #2563EB;
+  --covee-card: #FFFFFF;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --md-default-fg-color: #E7EBF3;
+    --md-default-fg-color--light: #9AA4B8;
+    --md-primary-fg-color: #60A5FA;
+    --md-accent-fg-color: #93C5FD;
+    --hs-border: #28334D;
+    --hs-bg: #0B1120;
+    --hs-focus-ring: #60A5FA;
+    --covee-card: #141C2F;
+  }
+}
+body { justify-content: center; }
+.md-typeset {
+  max-width: 440px !important;
+  background: var(--covee-card);
+  border-radius: 20px;
+  padding: 36px 28px 28px;
+  box-shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 16px 40px rgba(16, 24, 40, .10);
+  -webkit-font-smoothing: antialiased;
+}
+.md-typeset h1, .md-typeset h2 { font-weight: 650; color: var(--md-default-fg-color); letter-spacing: -.01em; }
+.md-typeset h2 { font-size: 1.35rem; text-align: center; margin-top: 0; }
+.headscale-logo, .headscale-logo:first-child { display: block; width: 56px; height: 56px; margin: 0 auto 20px; border-radius: 13px; }
+@media (max-width: 768px) { .headscale-logo { width: 56px; } }
+.md-typeset button {
+  width: 100%; min-height: 48px; border-radius: 12px; border: 0; font-weight: 560;
+  background: #2563EB; color: #FFFFFF;
+}
+.md-typeset button:hover { background: #1D4FD8; }
+.md-typeset footer { margin-top: 24px; }
